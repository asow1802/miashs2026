# ============================================================
#                   IMPORTATION DES DONNÉES
# ============================================================

data = read.csv(file = "/storage/emulated/0/Documents/Code python/sucre.csv",
                header = TRUE)

# Visualisation des données
View(data)


# ============================================================
#                   MODELE DE RÉGRESSION
# ============================================================

# Modèle linéaire OLS : y = β0 + β1*age + β2*size
modele = lm(y ~ age + size, data = data)

# Affichage des coefficients
print(modele)

# Résumé complet du modèle OLS
s_modele = summary(modele)


# ============================================================
#           GRAPHIQUES AFFICHÉS DANS UNE SEULE FENÊTRE
# ============================================================

# Ouvre une fenêtre graphique (compatible Ubuntu, Windows, Mac)
dev.new()

# Affiche 4 graphiques dans la même fenêtre
par(mfrow = c(2, 2))

# 1. y = f(size)
plot(data$size, data$y,
     col="red",
     main="y = f(size)",
     xlab = "Size", ylab = "y")

# 2. y = f(age)
plot(data$age, data$y,
     col="blue",
     main="y = f(age)",
     xlab = "Age", ylab = "y")

# 3. y = f(valeurs ajustées)
plot(modele$fitted.values, data$y,
     main="y = f(fitted)",
     xlab = "Fitted values", ylab = "y")

# 4. Résidus vs fitted
plot(modele$fitted.values, modele$residuals,
     col="green",
     main="Résidus vs valeurs ajustées",
     xlab = "Fitted values", ylab = "Résidus")

# Reset
par(mfrow = c(1, 1))


# ============================================================
#             EXTRACTION DES COEFFICIENTS β̂
# ============================================================

beta = s_modele$coefficients[, 1]
beta


# ============================================================
#    TEST D'HÉTÉROSCÉDASTICITÉ TYPE WHITE (REGRESSION AUXILIAIRE)
# ============================================================

# Résidus au carré
eps_hate_2 = modele$residuals^2
eps_hate_2
# Régression auxiliaire de White
new_modele = lm(eps_hate_2 ~ age + size +
                  I(age^2) + I(age*size) + I(size^2),
                data = data)

# Résumé de la régression auxiliaire
new_sum = summary(new_modele)

# R² auxiliaire
new_sum$r.squared

# Statistique du test de White : n * R²
nr2 = length(eps_hate_2) * new_sum$r.squared
nr2

# p-value du test χ² (ddl = 5 car 5 variables explicatives)
p_value = 1 - pchisq(nr2, 5)
p_value


# ============================================================
#        MATRICE DE VARIANCE-COVARIANCE DES BETA OLS
# ============================================================

vcov(modele)

# On charge le package lmtest pour utiliser bptest()
install.packages("zoo")
library(lmtest)

# Modèle de régression
modele = lm(eps_hate_2 ~ age + size +
                  I(age^2) + I(age*size) + I(size^2),
                data = data)

# Test de Breusch-Pagan d'homoscédasticité
# H0 : erreurs homoscédastiques
# H1 : hétéroscédasticité (variance dépend de age ou size)
result_bp = bptest(modele)

# Affichage du résultat
result_bp

# ====================================================================================
## MCQG : Beta = solve(Xtr*Dtr*D*X)*Xtr*Dtr*D*Y
# ==================================================================================
n = length(data[,1])
n
N = matrix(rep(1, n), nrow = n)
X = as.matrix(cbind(N, data$age, data$size) , nrow = n)
X
dim(X)
D = diag(1/sqrt(data$age))
Beta_thilde = solve(t(D%*%X)%*%D%*%X)%*%t(D%*%X)%*%D%*%data$y
Beta_thilde

## Estimation de la variance de beta_hat = 1/n Q-1JQ-1
J = eps_hate_2[1]*X[1,]%*%t(X[1,])
for (i in 2:n) {
  J = J + eps_hate_2[i]*X[i,]%*%t(X[i,])
  
}
J = 1/n*J
J
Q = (t(X)%*%X)/n
Q
###
V_beta_hat = 1/n * solve(Q)%*%J%*%solve(Q)
V_beta_hat
